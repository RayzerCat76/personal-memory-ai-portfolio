PERSONAL_AI_DB_PATH=./data/personal_ai.db
PERSONAL_AI_VECTOR_PATH=./data/vectors
PERSONAL_AI_FRIEND_SEED_PATH=./data/friend_seed.json
PERSONAL_AI_FRIEND_SEED_FEEDBACK_PATH=./data/friend_seed_feedback.json

PERSONAL_AI_LLM_PROVIDER=heuristic
PERSONAL_AI_MLX_MODEL=mlx-community/Qwen3-4B-4bit

# Standard local mode: Qwen embeddings through Ollama.
# If Ollama is unavailable, the backend safely falls back to lexical retrieval.
PERSONAL_AI_EMBEDDING_PROVIDER=ollama
PERSONAL_AI_OLLAMA_URL=http://127.0.0.1:11434
PERSONAL_AI_EMBEDDING_MODEL=qwen3-embedding:0.6b

PERSONAL_AI_MAX_RETRIEVAL=6
PERSONAL_AI_SEMANTIC_RETRIEVAL=8
